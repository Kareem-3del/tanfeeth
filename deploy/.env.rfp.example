# ---------------------------------------------------------------------------
# Shared RFP Intelligence stack env — ONE per environment.
# Copy to .env.rfp.prod and .env.rfp.staging on the host; fill secrets.
# NEVER commit the filled files.
#
# Used two ways, like the customer env:
#   1. compose substitution (--env-file) for docker-compose.rfp.yml
#      (RFP_ENV, RFP_IMAGE, RFP_NETWORK, RFP_ENV_FILE, DB_*).
#   2. the rfp service container's runtime env (env_file: -> RFP_ENV_FILE).
# Keep RFP_ENV_FILE pointing back at this same file.
# ---------------------------------------------------------------------------

# --- Environment / topology (compose substitution) -------------------------
# prod | staging. Separate DBs + volumes + nets per environment.
RFP_ENV=prod
RFP_IMAGE=ghcr.io/kareem-3del/tanfeeth-rfp:prod
# Shared internal net customers attach to. MUST match RFP_NETWORK in each
# customer's .env for the same environment.
RFP_NETWORK=tanfeeth-rfp-net-prod
# Path to THIS file (the rfp container's env_file). Point at the concrete file.
RFP_ENV_FILE=.env.rfp.prod

# --- Node runtime ----------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- Service auth ----------------------------------------------------------
# Shared secret the customer apis present (RFP_API_KEY) on every internal call.
# Rotate across .env.rfp.* AND every customers/*/.env together (R15).
RFP_SERVICE_TOKEN=__CHANGE_ME__

# --- Postgres (pgvector) ---------------------------------------------------
DB_HOST=tanfeeth-rfp-pg-prod
DB_PORT=5432
DB_USER=tanfeeth_rfp
DB_PASSWORD=__CHANGE_ME__
DB_NAME=tanfeeth_rfp
# Leave false. Migrations run on boot; the vector extension/columns are NOT
# ORM-describable, so synchronize=true cannot build this schema.
DB_SYNCHRONIZE=false

# --- OpenAI (embeddings + generation) --------------------------------------
# Optional in dev (heuristic adapters), REQUIRED to build real embeddings.
OPENAI_API_KEY=__CHANGE_ME__
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4o-mini
