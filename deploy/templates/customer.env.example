# ---------------------------------------------------------------------------
# Per-customer environment. Copied to customers/<slug>/.env by new-customer.sh.
# NEVER commit customers/<slug>/.env (see deploy/.gitignore). This file is the
# documented template only.
#
# This single file serves two roles:
#   1. docker compose variable substitution (--env-file) for the customer stack
#      (CUSTOMER_SLUG, API_IMAGE, WEB_IMAGE, RFP_NETWORK, DB_*).
#   2. the API container's runtime env (env_file:) — DB_*, JWT_*, RFP_*, seed.
# ---------------------------------------------------------------------------

# --- Identity / stack topology (compose substitution) ----------------------
# Slug is [a-z0-9-]; it names the containers, volume, internal net and nginx conf.
CUSTOMER_SLUG=__SLUG__
# Environment this customer belongs to: prod | staging. Selects the RFP stack.
CUSTOMER_ENV=prod
# Public web hostname (drives the nginx server_name + per-customer TLS cert).
WEB_HOST=__SLUG__.tanfeeth.io

# --- Images (compose substitution; rollout.sh rewrites the tag in place) ----
API_IMAGE=ghcr.io/kareem-3del/tanfeeth-api:prod
WEB_IMAGE=ghcr.io/kareem-3del/tanfeeth-frontend:prod

# --- Node / API runtime ----------------------------------------------------
NODE_ENV=production
PORT=3000

# --- Postgres (this customer's OWN database) -------------------------------
# DB_HOST MUST be the per-customer pg container name.
DB_HOST=tanfeeth-pg-__SLUG__
DB_PORT=5432
DB_USER=tanfeeth
DB_PASSWORD=__CHANGE_ME__
DB_NAME=tanfeeth
# CORRECTION: leave this false. Schema is created by migrations that run on API
# boot (migrationsRun). Do NOT flip to true to bootstrap a new customer DB.
DB_SYNCHRONIZE=false

# --- JWT — generate each with: openssl rand -hex 32 ------------------------
JWT_ACCESS_SECRET=__CHANGE_ME__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Seed (fresh customer only) --------------------------------------------
# For a NET-NEW customer: seed base permissions + first admin on first boot.
# For a customer MIGRATED from the shared org DB (migrate-org-to-customer.sh):
# set SEED_ON_BOOTSTRAP=false — the imported rows already contain roles/admin,
# and re-seeding would collide (R9).
SEED_ON_BOOTSTRAP=true
ADMIN_EMAIL=admin@__SLUG__.tanfeeth.io
ADMIN_PASSWORD=__CHANGE_ME__

# --- Shared RFP Intelligence service (per environment) ---------------------
# The customer api calls the shared internal RFP service over RFP_NETWORK.
# RFP_NETWORK must match CUSTOMER_ENV: tanfeeth-rfp-net-prod | tanfeeth-rfp-net-staging.
RFP_NETWORK=tanfeeth-rfp-net-prod
RFP_API_URL=http://tanfeeth-rfp-prod:3000
# Must equal RFP_SERVICE_TOKEN in .env.rfp for the matching environment.
RFP_API_KEY=__CHANGE_ME__
RFP_TIMEOUT_MS=20000
RFP_EXPORT_TIMEOUT_MS=60000
