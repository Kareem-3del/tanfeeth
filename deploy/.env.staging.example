# Copy to .env.staging on the server and fill real secrets (NEVER commit).
NODE_ENV=production
PORT=3000

DB_HOST=tanfeeth-pg-staging
DB_PORT=5432
DB_USER=tanfeeth
DB_PASSWORD=__CHANGE_ME__
DB_NAME=tanfeeth
DB_SYNCHRONIZE=true

JWT_ACCESS_SECRET=__CHANGE_ME__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Security — same posture as production; staging is a demo server (org_owner
# is granted on self-registration, so keep it closed).
SELF_REGISTRATION_ENABLED=false
# Swagger may be turned on for API exploration on staging if needed.
SWAGGER_ENABLED=false
# CORS: the staging web origin.
CORS_ALLOWED_ORIGINS=https://staging.tanfeeth.io

SEED_ON_BOOTSTRAP=true
ADMIN_EMAIL=admin@tanfeeth.io
ADMIN_PASSWORD=__CHANGE_ME__
