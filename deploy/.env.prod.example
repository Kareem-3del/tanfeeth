# Copy to .env.prod on the server and fill real secrets (NEVER commit .env.prod).
NODE_ENV=production
PORT=3000

# Postgres (compose injects DB_USER/DB_PASSWORD/DB_NAME into the db container too)
DB_HOST=tanfeeth-pg-prod
DB_PORT=5432
DB_USER=tanfeeth
DB_PASSWORD=__CHANGE_ME__
DB_NAME=tanfeeth
# First boot only: auto-create schema. Switch to migrations later.
DB_SYNCHRONIZE=true

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=__CHANGE_ME__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Seed base permissions + admin on first boot
SEED_ON_BOOTSTRAP=true
ADMIN_EMAIL=admin@tanfeeth.io
ADMIN_PASSWORD=__CHANGE_ME__
