{
  "manifest_version": 3,
  "name": "تنفيذ — التعبئة في اعتماد",
  "description": "جسر التعبئة التلقائية من منصة تنفيذ إلى نموذج إنشاء المنافسة في منصة اعتماد. لا يقوم بأي إرسال أو حفظ نيابةً عن المستخدم.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3002/*",
        "https://staging.tanfeeth.io/*",
        "https://tanfeeth.io/*",
        "https://www.tanfeeth.io/*"
      ],
      "js": [
        "src/tanfeeth-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tenders.etimad.sa/*"
      ],
      "js": [
        "src/field-meta.js",
        "src/etimad-fill.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-bridge.js"
      ],
      "matches": [
        "https://tenders.etimad.sa/*"
      ]
    }
  ]
}